# Copy to .env. Make loads this file and exports every variable to the three processes.

# Optional. Hugging Face token for faster, rate-limit-free model download.
HF_TOKEN=

# Required. Name of an AWS SSO profile from ~/.aws/config with Bedrock access.
AWS_PROFILE=

AWS_REGION=us-east-1
DECIDER_URL=http://127.0.0.1:8099
LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# mps (Apple silicon) | cuda | cpu. Defaults to mps on Apple silicon, cpu elsewhere.
# DECIDER_DEVICE=mps
